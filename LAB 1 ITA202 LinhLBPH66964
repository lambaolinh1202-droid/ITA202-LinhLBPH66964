# BÀI 4: QUY TRÌNH ML HOÀN CHỈNH - PHẦN 1: Thu thập và Kiểm tra dữ liệu
# ==========================================

import matplotlib.pyplot as plt
from sklearn.datasets import load_digits

# 1. Tải tập dữ liệu digits
digits = load_digits()
X = digits.data
y = digits.target

# 2. In ra hình dạng (shape) của dữ liệu và nhãn
print("=== THÔNG TIN KÍCH THƯỚC DỮ LIỆU ===")
print(f"Hình dạng của dữ liệu đầu vào (X.shape): {X.shape}")
print(f"Hình dạng của nhãn (y.shape): {y.shape}")
print("\n" + "="*50 + "\n")

# 3. Hiển thị mẫu dữ liệu đầu tiên dưới dạng hình ảnh
print("=== HIỂN THỊ MẪU DỮ LIỆU ĐẦU TIÊN ===")
print(f"Nhãn (ý nghĩa thực tế) của mẫu đầu tiên là: {y[0]}")

# Vẽ hình ảnh trực quan của chữ số đầu tiên
plt.figure(figsize=(3, 3))
plt.imshow(digits.images[0], cmap='gray')
plt.title(f"Nhãn: {y[0]}")
plt.axis('off') # Tắt trục tọa độ cho gọn
plt.show()















