# ==========================================
# BÀI 3: Chạy thử mô hình đơn giản với Scikit-Learn
# ==========================================

import numpy as np
from sklearn.datasets import load_iris
from sklearn.linear_model import LinearRegression

# Bước 1: Load dữ liệu Iris (Lấy đặc trưng đầu vào X và nhãn y)
iris = load_iris()
X = iris.data
y = iris.target

print("=== 1. TẢI DỮ LIỆU THÀNH CÔNG ===")
print(f"Số lượng mẫu dữ liệu: {X.shape[0]}")
print(f"Số lượng đặc trưng (features) của mỗi mẫu: {X.shape[1]}")
print("\n" + "="*50 + "\n")

# Bước 2: Khởi tạo mô hình Linear Regression
model = LinearRegression()

# Bước 3: Huấn luyện mô hình (Fit) với dữ liệu
model.fit(X, y)
print("=== 2. HUẤN LUYỆN MÔ HÌNH (FIT) ===")
print("Mô hình đã học xong từ dữ liệu!")
print("\n" + "="*50 + "\n")

# Bước 4: Dự đoán (Predict) thử với 5 mẫu dữ liệu đầu tiên trong tập
# (Do Linear Regression trả về số thực, ta sẽ làm tròn hoặc xem giá trị dự đoán)
du_doan = model.predict(X[:5])
thuc_te = y[:5]

print("=== 3. KẾT QUẢ DỰ ĐOÁN (PREDICT) ===")
print(giá_trị_dự_đoán := [f"Mẫu {i+1} - Thực tế: {thuc_te[i]} | Dự đoán: {du_doan[i]:.2f}" for i in range(5)])




